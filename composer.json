{
  "name": "oxygen/auth",
  "description": "Authorisation Component",
  "license": "MIT",
  "keywords": [
    "cms",
    "framework",
    "OxygenExtension"
  ],
  "authors": [
    {
      "name": "Chris Chamberlain",
      "email": "chris@chamberlain.id.au"
    }
  ],
  "require": {
    "php": ">=8.3",
    "oxygen/core": "~1.2.0",
    "oxygen/data": "~0.14.0",
    "illuminate/support": "^12.0",
    "laravel/sanctum": "^4.0",
    "guzzlehttp/guzzle": "^7.4.5",
    "ext-json": "*",
    "ext-zip": "*",
    "lab404/laravel-impersonate": "^1.7",
    "webmozart/assert": "^1.10",
    "bacon/bacon-qr-code": "^2.0",
    "doctrine/orm": "^3.1",
    "paragonie/constant_time_encoding": "^2.0",
    "spomky-labs/otphp": "^11.1"
  },
  "autoload": {
    "psr-4": {
      "Oxygen\\Auth\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "extra": {
    "laravel": {
      "providers": [
        "Oxygen\\Auth\\AuthServiceProvider",
        "Oxygen\\Auth\\Session\\DoctrineSessionServiceProvider"
      ]
    }
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^1.8",
    "phpspec/phpspec": "^7.0",
    "phpstan/extension-installer": "^1.1",
    "phpstan/phpstan-webmozart-assert": "^1.2.1"
  },
  "scripts": {
    "test": "vendor/bin/phpspec run && vendor/bin/phpstan analyse --memory-limit 256M"
  }
}
